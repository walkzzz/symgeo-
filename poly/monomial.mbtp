// Logical-side specifications for the polynomial proof model layer.
// .mbtp = proof side only; never called by runtime code.
//
// The prove model works over FixedArray[Int32]; the Array-backed runtime
// functions (Monomial::total_degree etc.) mirror these models structurally.

/// A nonnegative quantity (degree-like measures).
predicate nonneg(x : Int) {
  0 <= x
}

/// Monomial degree model: exponents are ordinary mathematical integers.
predicate exponent_list(xs : FixedArray[Int]) {
  ∀ i : Int, (0 <= i) && (i < xs.length()) → 0 <= xs[i]
}

/// Proof-model fact backing `Polynomial::degree`: any result is >= -1
/// (the empty/exponent-less case models the zero polynomial).
predicate degree_bound(result : Int) {
  -1 <= result
}
